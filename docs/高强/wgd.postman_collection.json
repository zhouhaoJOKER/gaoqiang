{
  "info": {
    "name": "高强 Rails API - 外跟单自动化验证",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "username",
      "value": "user1"
    },
    {
      "key": "password",
      "value": "123123123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "wgd_order_id",
      "value": ""
    },
    {
      "key": "wgd_order_line_id",
      "value": ""
    },
    {
      "key": "test_code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 登录获取 Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function base64Utf8(value) {",
              "  return btoa(unescape(encodeURIComponent(value || '')));",
              "}",
              "",
              "function wrap(value) {",
              "  return 'x.' + base64Utf8(value) + '.x';",
              "}",
              "",
              "const username = pm.collectionVariables.get('username');",
              "const password = pm.collectionVariables.get('password');",
              "",
              "pm.request.body.update(JSON.stringify({",
              "  name: wrap(username),",
              "  password: wrap(password)",
              "}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('登录 HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "const token = json.token || json.refreshToken || (json.data && (json.data.token || json.data.refreshToken));",
              "",
              "pm.test('登录成功并返回 token', function () {",
              "  pm.expect(json.code).to.eql(200);",
              "  pm.expect(token).to.be.ok;",
              "});",
              "",
              "if (token) {",
              "  pm.collectionVariables.set('token', token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 创建外跟单订单（含明细）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/wgd/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "wgd",
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = 'WGD-POSTMAN-' + Date.now();",
              "pm.collectionVariables.set('test_code', code);",
              "",
              "pm.request.body.update(JSON.stringify({",
              "  code: code,",
              "  client_name: 'Postman测试客户',",
              "  contract_code: 'HT-POSTMAN-001',",
              "  receive_date: '2026-05-10',",
              "  hazard_pack_month: '已办26.05',",
              "  customer_delivery_date_text: '测试交期',",
              "  follower_name: 'Postman',",
              "  invoice_status: '未开票',",
              "  remark: 'Postman自动化创建',",
              "  line_items: [",
              "    {",
              "      product_name: '1L 阻隔瓶',",
              "      model: '1L-TEST',",
              "      foil_pad_status: '有结存',",
              "      color: '白',",
              "      requirements: '白瓶白盖，自动化测试',",
              "      weight: '120G',",
              "      color_master_status: '有结存',",
              "      product_image_text: '测试图文',",
              "      qty: 1000,",
              "      unit: '只',",
              "      unit_price: 1.23,",
              "      line_amount: 1230,",
              "      delivered_qty: 0,",
              "      undelivered_qty: 1000,",
              "      sort: 1,",
              "      remark: '首条测试明细'",
              "    }",
              "  ]",
              "}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('创建订单 HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('创建订单成功', function () {",
              "  pm.expect(json.code).to.eql(200);",
              "  pm.expect(json.data.id).to.be.ok;",
              "});",
              "",
              "pm.collectionVariables.set('wgd_order_id', json.data.id);",
              "",
              "if (json.data.line_items && json.data.line_items.length > 0) {",
              "  pm.collectionVariables.set('wgd_order_line_id', json.data.line_items[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 查询外跟单订单列表",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/wgd/orders?page=1&size=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "wgd",
            "orders"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('查询订单列表成功', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.code).to.eql(200);",
              "  pm.expect(json.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 查询外跟单订单详情",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/wgd/orders/{{wgd_order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "wgd",
            "orders",
            "{{wgd_order_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('查询订单详情成功', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.code).to.eql(200);",
              "  pm.expect(json.data.id).to.eql(Number(pm.collectionVariables.get('wgd_order_id')));",
              "  pm.expect(json.data.line_items).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
