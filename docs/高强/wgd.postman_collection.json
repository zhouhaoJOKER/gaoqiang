{
  "info": {
    "name": "高强 Rails API - 外跟单调试",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "Admin"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 登录获取 Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function base64Utf8(value) {",
              "  return btoa(unescape(encodeURIComponent(value || '')));",
              "}",
              "",
              "function wrap(value) {",
              "  return 'x.' + base64Utf8(value) + '.x';",
              "}",
              "",
              "const username = pm.collectionVariables.get('username');",
              "const password = pm.collectionVariables.get('password');",
              "",
              "pm.request.body.update(JSON.stringify({",
              "  name: wrap(username),",
              "  password: wrap(password)",
              "}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('登录成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "const token = json.token || json.refreshToken || (json.data && (json.data.token || json.data.refreshToken));",
              "",
              "pm.test('返回 token', function () {",
              "  pm.expect(token).to.be.ok;",
              "});",
              "",
              "if (token) {",
              "  pm.collectionVariables.set('token', token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 查询外跟单订单列表",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/wgd/orders?page=1&size=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "wgd",
            "orders"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('查询成功', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('接口返回 code=200', function () {",
              "  pm.expect(json.code).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
